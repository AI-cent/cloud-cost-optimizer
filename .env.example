# ─────────────────────────────────────────────────────────────────────────────
# Cloud Cost Optimizer — Environment Variables
# Copy this file to .env and fill in your values before starting the server.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong random key:  python3 -c "import secrets; print(secrets.token_hex(32))"
# The server will refuse to start if this is missing or set to a default value.
JWT_SECRET_KEY=replace-with-a-64-char-random-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./cost_optimizer.db

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Cloud Cost Optimizer

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to simulate remediation without calling AWS (safe for demos).
# Set to "false" to enable live AWS API remediation.
DEMO_MODE=true

# ── Email Notifications (SMTP) ────────────────────────────────────────────────
# For Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords
# Select "Mail" + device name and paste the 16-character password below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_EMAIL=your-email@gmail.com
NOTIFICATION_EMAIL=recipient@company.com

# ── Logging ───────────────────────────────────────────────────────────────────
# Optional: override the log file path (defaults to app.log beside main.py)
# LOG_FILE=/var/log/cloud-cost-optimizer/app.log
